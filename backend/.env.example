# Server Port
PORT=5000

# Environment: development or production
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Replace with your actual MongoDB Atlas URI
MONGO_DB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/NFC?retryWrites=true&w=majority

# Public Base URL for permanent QR redirection (used in generated QR codes)
# In development: http://localhost:5000
# In production: https://api.yourdomain.com (or your deployed backend URL)
BASE_URL=http://localhost:5000

# Allowed Frontend Origins for CORS (comma-separated if multiple)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# Optional API Security Key for Card Activation & Updates
# Keep this secret. Pass in request header 'x-api-key' from authorized clients.
# In development, leave blank or pass this key.
API_SECRET_KEY=nfc_secret_key_change_in_production
