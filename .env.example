# ========================================================
# TAPFORM NFC & DYNAMIC QR PLATFORM - ENVIRONMENT CONFIG
# ========================================================

# Server Port (Render / Railway / Heroku injects this automatically)
PORT=5000

# Environment: production or development
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGO_DB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/NFC?retryWrites=true&w=majority

# Public Domain Base URL for generated QR codes & NFC tags
# (Leave blank to auto-detect dynamically from the user's browser URL / host header)
# If using a custom domain, set it here (e.g. https://tapform.in or https://your-app.onrender.com)
BASE_URL=

# Allowed Frontend Origins for CORS (comma-separated)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# Security Key for card activation & updates (Optional)
API_SECRET_KEY=nfc_secret_key_change_in_production

# Secret Master Passcode for /admin Panel Access
ADMIN_PASSWORD=admin1234
